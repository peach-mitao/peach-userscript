{
  "name": "@peach-mitao/peach-userscript",
  "version": "0.7.13",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "peach": {
    "install_url": "/integrations/peach-jav.user.js",
    "bridge_min_version": "0.5.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "preview": "node scripts/preview.ts",
    "check": "node scripts/build.ts --check",
    "export": "node scripts/export.ts",
    "test": "node --test tests/build.test.ts tests/candidates.test.ts tests/export-peach.test.ts tests/release-notes.test.ts tests/ci_plan.test.ts",
    "test:browser": "node --test tests/browser.test.ts",
    "verify": "npm run check && npm test && npm run test:browser",
    "candidates": "node scripts/sync-candidates.ts"
  },
  "devDependencies": {
    "playwright-core": "1.64.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/peach-mitao/peach-userscript.git"
  }
}
